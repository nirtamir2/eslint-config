  "homepage": "https://github.com/nirtamir2/eslint-config",
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./oxlint": "./dist/oxlint.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": "./bin/index.mjs",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "nr typegen && nr check:oxlint-generated && tsdown --clean --dts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "check:oxlint-generated": "tsx scripts/generate-oxlint.ts --check",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "format": "prettier \"**/*\" --write --ignore-unknown",
    "generate:oxlint": "tsx scripts/generate-oxlint.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint --config oxlint.config.ts",
    "prepack": "nr build",
    "prepare": "simple-git-hooks",
    "release": "bumpp --tag eslint-config-v%s",
    "stub": "tsdown",
    "test": "vitest",
    "test:oxlint-package": "tsx scripts/test-oxlint-package.ts",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typegen": "esno scripts/typegen.ts",
    "watch": "tsdown --watch"
  },
